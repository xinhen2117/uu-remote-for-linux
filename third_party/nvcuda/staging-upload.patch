+    if (copy->dstXInBytes > width || copy->WidthInBytes > width - copy->dstXInBytes ||
+        copy->dstY > rows || copy->Height > rows - copy->dstY)
+        return CUDA_ERROR_INVALID_VALUE;
+
+    if (!resource->upload_mapped)
+    {
+        hr = ID3D11DeviceContext_Map(resource->context,
+             (ID3D11Resource *)resource->upload_texture, 0, D3D11_MAP_WRITE,
+             0, &resource->upload_map);
+        if (FAILED(hr))
+        {
+            ERR("UU Remote staging upload Map failed (%#lx)\n", (unsigned long)hr);
+            return CUDA_ERROR_UNKNOWN;
+        }
+        resource->upload_mapped = TRUE;
+        if (resource->upload_map.RowPitch < width)
+        {
+            ID3D11DeviceContext_Unmap(resource->context,
+                (ID3D11Resource *)resource->upload_texture, 0);
+            resource->upload_mapped = FALSE;
+            return CUDA_ERROR_INVALID_VALUE;
+        }
+        if (!resource->upload_initialized)
+        {
+            /* Match the zero-initialized CPU buffer on a first partial write. */
+            for (row = 0; row < rows; row++)
