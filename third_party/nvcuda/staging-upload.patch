+    host_copy.dstMemoryType = UU_REMOTE_CU_MEMORYTYPE_HOST;
+    host_copy.dstHost = resource->upload_map.pData;
+    host_copy.dstDevice = 0;
+    host_copy.dstArray = NULL;
+    host_copy.dstPitch = resource->upload_map.RowPitch;
+    result = pcuMemcpy2D_v2(&host_copy);
+    if (result == CUDA_SUCCESS)
